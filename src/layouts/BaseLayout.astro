---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DevSwitcher from '../components/dev/DevSwitcher.astro';
import { fonts, fontStack } from '../theme/fonts';
import { theme, accents } from '../theme/theme';
import { langs, routes, useTranslations, withBase, type Lang, type RouteKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  route: RouteKey;
  title?: string;
  description?: string;
}

const { lang, route, title, description } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ?? (route === 'home' ? t('meta.title') : `${t(`pages.${route}.title`)} – Akribis`);
const pageDescription = description ?? (route === 'home' ? t('meta.description') : t(`pages.${route}.description`));

const canonical = new URL(routes[route][lang], Astro.site);
const alternates = langs.map((l) => ({ lang: l, href: new URL(routes[route][l], Astro.site).href }));

const fontFaces = fonts
  .flatMap((font) =>
    font.files.map(
      (f) =>
        `@font-face{font-family:'${font.name}';src:url('${withBase(`/fonts/${f.file}`)}') format('woff2');font-weight:${f.weight};font-style:${f.style ?? 'normal'};font-display:swap}`,
    ),
  )
  .join('\n');

const accent = accents[theme.accent];
const themeVars = [
  `--font-heading:${fontStack(theme.headingFont)}`,
  `--font-body:${fontStack(theme.bodyFont)}`,
  `--font-mono:${fontStack(theme.monoFont)}`,
  `--font-logo:${fontStack('Zen Dots')}`,
  `--font-tagline:${theme.taglineLogoFont ? 'var(--font-logo)' : 'var(--font-heading)'}`,
  `--accent-l:${accent.light.color}`,
  `--accent-l-text:${accent.light.text}`,
  `--accent-l-on:${accent.light.on}`,
  `--accent-d:${accent.dark.color}`,
  `--accent-d-text:${accent.dark.text}`,
  `--accent-d-on:${accent.dark.on}`,
].join(';');

const preloadFonts = [theme.headingFont, theme.bodyFont]
  .map((name) => fonts.find((f) => f.name === name)?.files.find((f) => (f.style ?? 'normal') === 'normal')?.file)
  .filter((file, i, arr): file is string => !!file && arr.indexOf(file) === i);
---

<!doctype html>
<html lang={lang} data-theme={theme.mode} style={themeVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <meta name="theme-color" content={theme.mode === 'dark' ? '#0f0f0f' : '#f7f7f5'} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Akribis" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en_GB'} />

    {preloadFonts.map((file) => <link rel="preload" href={withBase(`/fonts/${file}`)} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={fontFaces}></style>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header lang={lang} route={route} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    {import.meta.env.DEV && <DevSwitcher />}
  </body>
</html>
