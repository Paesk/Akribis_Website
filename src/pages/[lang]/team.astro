---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Team from '../../components/sections/Team.astro';
import Coaches from '../../components/sections/Coaches.astro';
import { langPaths, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return langPaths();
}

const lang = Astro.params.lang as Lang;
---

<BaseLayout lang={lang} route="team">
  <Team lang={lang} level={1} />
  {/* Coaches & Supervision incl. academic partners */}
  <Coaches lang={lang} />
</BaseLayout>
