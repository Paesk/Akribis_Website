---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routeFor } from '../i18n/utils';
---

<BaseLayout lang="en" route="home" title="Page not found – Akribis">
  <section class="not-found" aria-labelledby="nf-title">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 id="nf-title">Page not found</h1>
      <p lang="de">Seite nicht gefunden</p>
      <p class="not-found__links">
        <a class="btn btn--primary" href={routeFor('home', 'en')}>Akribis – English</a>
        <a class="btn btn--secondary" href={routeFor('home', 'de')} lang="de">Akribis – Deutsch</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(4rem, 12vw, 9rem);
  }
  .not-found .container {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }
  h1 {
    font-size: var(--step-3);
  }
  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
