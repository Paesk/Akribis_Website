---
import Logo from './Logo.astro';
import ContactEmail from './ContactEmail.astro';
import SocialLinks from './SocialLinks.astro';
import { navRoutes, routeFor, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href={routeFor('home', lang)} class="site-footer__logo" aria-label={t('nav.home')}>
        <Logo variant="stacked" label="" />
      </a>
      <p class="site-footer__line">{t('meta.projectLine')}</p>
    </div>

    <nav class="site-footer__col" aria-labelledby="footer-pages">
      <p class="eyebrow" id="footer-pages">{t('footer.pages')}</p>
      <ul class="site-footer__pages">
        {
          navRoutes.map((key) => (
            <li>
              <a href={routeFor(key, lang)}>{t(`nav.${key}`)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__col">
      <p class="eyebrow">{t('contact.email')}</p>
      <ContactEmail />
    </div>

    <div class="site-footer__col">
      <p class="eyebrow">{t('contact.socials')}</p>
      <SocialLinks compact />
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>© {year} Akribis · ETH Zürich</p>
    <a class="site-footer__legal" href={routeFor('imprint', lang)}>{t('footer.imprint')}</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-top: clamp(3rem, 6vw, 4.5rem);
    font-size: 0.9375rem;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }
  .site-footer__logo {
    display: inline-block;
  }
  .site-footer__logo :global(.logo) {
    width: 8.5rem;
  }
  .site-footer__line {
    margin-top: 1.25rem;
    max-width: 30ch;
    color: var(--color-muted);
  }
  .site-footer__col {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.75rem;
  }
  .site-footer__pages {
    display: grid;
    gap: 0.4rem;
    list-style: none;
  }
  .site-footer__pages a {
    text-decoration: none;
  }
  .site-footer__pages a:hover {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (max-width: 1000px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem 1.5rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .site-footer__legal {
    color: var(--color-text);
    text-underline-offset: 0.2em;
  }
  .site-footer__legal:hover {
    color: var(--color-accent-text);
  }
  @media (max-width: 760px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
