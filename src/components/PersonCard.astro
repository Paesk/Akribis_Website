---
import Heading from './Heading.astro';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Placeholder from './Placeholder.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  name: string;
  photo: ImageMetadata | null;
  /** Main line, e.g. subteam (bold) */
  primary?: string;
  /** Small muted line below the main line, e.g. "Soft role · Photography" */
  secondary?: string;
  meta?: string;
  linkedin?: string;
  size?: 'default' | 'small';
  /** Level of the name heading (h2 on a page whose section title is h1) */
  headingLevel?: number;
}

const { name, photo, primary, secondary, meta, linkedin, size = 'default', headingLevel = 3 } = Astro.props;
const t = useTranslations((Astro.currentLocale ?? 'en') as Lang);
---

<article class:list={['person', `person--${size}`]}>
  {
    photo ? (
      <Picture
        class="person__photo"
        src={photo}
        formats={['avif', 'webp']}
        widths={[240, 400, 640]}
        sizes="(max-width: 560px) 50vw, (max-width: 1000px) 33vw, 300px"
        alt={name}
        loading="lazy"
      />
    ) : (
      <Placeholder media class="person__photo" label={t('team.photo')} ratio="4 / 5" />
    )
  }
  <div class="person__body">
    <Heading level={headingLevel} class="person__name">{name}</Heading>
    {primary && <p class="person__primary">{primary}</p>}
    {secondary && <p class="person__secondary">{secondary}</p>}
    {meta && <p class="person__meta">{meta}</p>}
    {
      linkedin && (
        <a class="person__link text-link" href={linkedin} rel="noopener noreferrer" target="_blank">
          LinkedIn
          <span class="visually-hidden">{t('team.linkedin', { name })}</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .person {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 1rem;
  }
  .person :global(.person__photo) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }
  /* Small cards (coaches): photo beside the text, so names get the full remaining width */
  .person--small {
    grid-template-columns: 6rem minmax(0, 1fr);
    align-items: start;
    column-gap: 1rem;
  }
  .person--small :global(.person__photo) {
    aspect-ratio: 1;
  }
  .person--small :global(.ph) {
    padding: 0.4rem;
  }
  .person--small :global(.ph__tag) {
    padding: 0.05rem 0.25rem;
    font-size: 0.5625rem;
    letter-spacing: 0.04em;
  }
  .person--small .person__body {
    padding-top: 0.25rem;
  }
  .person__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: 0.3rem;
  }
  .person__name {
    font-size: var(--step-1);
    font-weight: 600;
  }
  .person__primary {
    font-weight: 700;
  }
  /* Two narrow columns on phones: keep "Subteam · Electronics" on one line */
  @media (max-width: 480px) {
    .person__primary {
      font-size: 0.9375rem;
    }
  }
  .person__secondary {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
  .person__meta {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.45;
    /* "Maschineningenieurwissenschaften" is wider than a phone column; `anywhere` covers browsers without a German hyphenation dictionary */
    hyphens: auto;
    overflow-wrap: anywhere;
  }
  .person--small .person__meta {
    font-size: 0.9375rem;
  }
  .person__link {
    margin-top: 0.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }
</style>
