---
/**
 * Small UI icons (inline SVG, no external files).
 * Always rendered with explicit width/height attributes, so an icon keeps its size
 * even before/without CSS and can never scale up to fill its container.
 * CSS may still set the size via the `.icon` class or a local rule.
 */
type IconName = 'arrow-right' | 'external' | 'check' | 'warning';

interface Props {
  name: IconName;
  /** Rendered size, used for the width/height attributes (default 1em) */
  size?: string;
  class?: string;
}

const { name, size = '1em', class: className } = Astro.props;

const viewBox: Record<IconName, string> = {
  'arrow-right': '0 0 20 20',
  external: '0 0 16 16',
  check: '0 0 16 16',
  warning: '0 0 16 16',
};
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox={viewBox[name]}
  aria-hidden="true"
  focusable="false"
  style={`--icon-size:${size}`}
>
  {name === 'arrow-right' && <path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" />}
  {name === 'external' && <path d="M5.5 3.5h7v7M12.5 3.5l-9 9" fill="none" stroke="currentColor" stroke-width="1.5" />}
  {name === 'check' && <path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" />}
  {
    name === 'warning' && (
      <>
        <path d="M8 1.5 15 14H1L8 1.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
        <path d="M8 6v3.5M8 11.4v.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </>
    )
  }
</svg>
