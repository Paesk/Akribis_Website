---
import { render } from 'astro:content';
import SectionHeader from '../SectionHeader.astro';
import { getSection } from '../../lib/content';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  /** 1 when this section is the main content of its page */
  level?: 1 | 2;
  /** Optional section number, e.g. "01" */
  index?: string;
}

const { lang, level = 2, index } = Astro.props;
const t = useTranslations(lang);
const { entry, data, translationMissing, needsProofreading } = await getSection(lang, 'challenge');
const { Content } = await render(entry);
---

<section id="challenge" class="section challenge" aria-labelledby="challenge-title">
  <div class="container challenge__grid">
    <div class="challenge__head">
      <SectionHeader
        index={index}
        level={level}
        kicker={t('sections.challenge')}
        title={data.title}
        headingId="challenge-title"
        translationMissing={translationMissing}
        needsProofreading={needsProofreading}
      />
      <div class="challenge__scale" aria-hidden="true">
        <svg width="240" height="90" viewBox="0 0 240 90" fill="none">
          <path
            d="M6 45c0 0 16 38 38 38 38 0 38-76 76-76 22 0 38 38 38 38"
            stroke="var(--color-line)"
            stroke-width="2"
            stroke-dasharray="4 5"></path>
          <path d="M6 45h228" stroke="var(--color-accent)" stroke-width="2"></path>
          <circle cx="234" cy="45" r="4.5" fill="var(--color-accent)"></circle>
        </svg>
      </div>
    </div>

    <div class="challenge__body">
      <div class="prose challenge__prose" lang={translationMissing ? 'en' : undefined}>
        <Content />
      </div>

      {
        data.sources.length > 0 && (
          <details class="sources">
            <summary class="eyebrow">{t('challenge.sources')}</summary>
            <ol>
              {data.sources.map((s) => (
                <li>
                  <a class="text-link" href={s.url} rel="noopener noreferrer" target="_blank">
                    {s.label}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )
      }
    </div>
  </div>
</section>

<style>
  .challenge__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 6rem);
  }
  .challenge__head {
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
  .challenge__scale {
    display: grid;
    gap: 0.75rem;
    max-width: 15rem;
  }
  .challenge__prose {
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--color-text);
  }
  .challenge__prose :global(p:has(> strong:only-child)) {
    margin-top: 2rem;
    padding-left: 1.25rem;
    border-left: 3px solid var(--color-accent);
    font-family: var(--font-heading);
    font-size: var(--step-2);
    line-height: 1.25;
  }
  .sources {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
  }
  .sources summary {
    cursor: pointer;
    width: fit-content;
  }
  .sources summary:hover {
    color: var(--color-text);
  }
  .sources ol {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-left: 1.25rem;
  }
  @media (max-width: 860px) {
    .challenge__grid {
      grid-template-columns: 1fr;
    }
    .challenge__head {
      position: static;
    }
    .challenge__scale {
      display: none;
    }
  }
</style>
