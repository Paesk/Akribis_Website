---
import Heading from '../Heading.astro';
import { Picture } from 'astro:assets';
import SectionHeader from '../SectionHeader.astro';
import Placeholder from '../Placeholder.astro';
import { getSection } from '../../lib/content';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  /** 1 when this section is the main content of its page */
  level?: 1 | 2;
  /** Optional section number, e.g. "01" */
  index?: string;
}

const { lang, level = 2, index } = Astro.props;
const t = useTranslations(lang);
const { data, translationMissing, needsProofreading } = await getSection(lang, 'technology');
---

<section id="technology" class="section technology" aria-labelledby="technology-title">
  <div class="container" lang={translationMissing ? 'en' : undefined}>
    <SectionHeader
      index={index}
      level={level}
      kicker={t('sections.technology')}
      title={data.title}
      headingId="technology-title"
      translationMissing={translationMissing}
      needsProofreading={needsProofreading}
    >
      {data.intro && <p class="lead">{data.intro}</p>}
    </SectionHeader>

    <ul class="tech-cards">
      {
        data.cards.map((card) => (
          <li class="tech-card">
            {card.image ? (
              <Picture
                class="tech-card__media"
                src={card.image}
                formats={['avif', 'webp']}
                widths={[320, 640, 960]}
                sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 300px"
                alt={card.image_alt ?? ''}
              />
            ) : (
              <Placeholder media class="tech-card__media" label={t('technology.imagePlaceholder')} ratio="4 / 3" />
            )}
            <div class="tech-card__body">
              <Heading level={level + 1} class="tech-card__title">{card.title}</Heading>
              <p class="tech-card__text">{card.text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    {
      data.specs.length > 0 && (
        <div class="specs">
          <Heading level={level + 1} class="specs__title eyebrow" id="specs-title">
            {t('technology.specsTitle')}
          </Heading>
          <div class="specs__scroll">
            <table class="specs__table" aria-labelledby="specs-title">
              <thead class="visually-hidden">
                <tr>
                  <th scope="col">{t('technology.parameter')}</th>
                  <th scope="col">{t('technology.value')}</th>
                </tr>
              </thead>
              <tbody>
                {data.specs.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td>
                      {row.value ? (
                        <span class="mono">{row.value}</span>
                      ) : (
                        <span class="specs__tbd mono">{t('markers.tbd')}</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .tech-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    list-style: none;
  }
  .tech-card {
    display: grid;
    grid-template-rows: auto 1fr;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    overflow: hidden;
    transition: border-color 0.2s var(--ease);
  }
  .tech-card:hover {
    border-color: var(--color-line);
  }
  .tech-card :global(.tech-card__media) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 0;
    border-bottom: 1px dashed var(--color-line);
    border-radius: 0;
  }
  .tech-card__body {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.25rem 1.25rem 1.5rem;
  }
  .tech-card__title {
    font-size: var(--step-1);
  }
  .tech-card__text {
    color: var(--color-muted);
    font-size: 0.9688rem;
    line-height: 1.55;
  }

  .specs {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 1rem clamp(2rem, 6vw, 6rem);
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .specs__title {
    padding-top: 1rem;
  }
  .specs__scroll {
    overflow-x: auto;
  }
  .specs__table {
    width: 100%;
    border-collapse: collapse;
  }
  .specs__table tr {
    border-bottom: 1px solid var(--color-border);
  }
  .specs__table tr:first-child {
    border-top: 1px solid var(--color-text);
  }
  .specs__table th,
  .specs__table td {
    padding: 0.9rem 0;
    text-align: left;
    vertical-align: middle;
  }
  .specs__table th {
    font-weight: 500;
    padding-right: 1rem;
  }
  .specs__table td {
    text-align: right;
  }
  .specs__tbd {
    display: inline-block;
    padding: 0 0.6rem;
    border: 1.5px dashed var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface-2);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  @media (max-width: 1100px) {
    .tech-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .specs {
      grid-template-columns: 1fr;
    }
    .specs__title {
      padding-top: 0;
    }
  }
  @media (max-width: 560px) {
    .tech-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
